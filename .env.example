# LLM & Whisper API Configuration
LLM_API_KEY=your_llm_api_key_here
LLM_API_URL=https://api.openai.com/v1/chat/completions
WHISPER_API_KEY=your_whisper_api_key_here
WHISPER_API_URL=https://api.groq.com/openai/v1/audio/transcriptions

# Server Configuration
SERVER_PORT=8080
STORAGE_UPLOAD_DIR=./uploads
STORAGE_OUTPUT_DIR=./output
STORAGE_CACHE_DIR=./cache

# F01 — Khóa bí mật ký JWT HS256 (tối thiểu 32 byte) và tài khoản admin khởi tạo (không hardcode trong code).
# Bắt buộc có JWT_SECRET khi chạy ngoài profile test.
JWT_SECRET=replace-with-a-random-secret-key-at-least-32-bytes-long
AUTOCUT_BOOTSTRAP_ADMIN_EMAIL=
AUTOCUT_BOOTSTRAP_ADMIN_PASSWORD=

# F05 — CORS: danh sách origin được phép gọi API, cách nhau bằng dấu phẩy.
# Dev/test không đặt thì mặc định http://localhost:3000,http://127.0.0.1:3000.
# Production (profile prod, hoặc không có profile) mà thiếu biến này thì ứng
# dụng KHÔNG khởi động. Biến này đọc qua ConfigService nên đặt trong .env có tác dụng.
AUTOCUT_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# F05 — profile Spring KHÔNG đọc từ .env (dự án nạp .env bằng Dotenv thủ công).
# Chạy local phải set biến môi trường thật:
#   PowerShell: $env:SPRING_PROFILES_ACTIVE="dev"
#   bash:       export SPRING_PROFILES_ACTIVE=dev
#   Maven:      mvn spring-boot:run -Dspring-boot.run.profiles=dev

# Cloudflare R2 Storage (S3-compatible)
R2_ENDPOINT=https://7b8d9e6bf945add2f99f39d0746a42f3.r2.cloudflarestorage.com
R2_BUCKET_NAME=autocut
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
# Neon Postgres Cloud Database
DATABASE_URL=postgres://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgres://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
NEON_BRANCH=production
