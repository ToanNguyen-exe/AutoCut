# LLM & Whisper API Configuration
LLM_API_KEY=your_llm_api_key_here
LLM_API_URL=https://api.openai.com/v1/chat/completions
WHISPER_API_KEY=your_whisper_api_key_here
WHISPER_API_URL=https://api.groq.com/openai/v1/audio/transcriptions

# Server Configuration
SERVER_PORT=8080
STORAGE_UPLOAD_DIR=./uploads
STORAGE_OUTPUT_DIR=./output
STORAGE_CACHE_DIR=./cache

# Cloudflare R2 Storage (S3-compatible)
R2_ENDPOINT=https://7b8d9e6bf945add2f99f39d0746a42f3.r2.cloudflarestorage.com
R2_BUCKET_NAME=autocut
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
# Neon Postgres Cloud Database
DATABASE_URL=postgres://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgres://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
NEON_BRANCH=production
