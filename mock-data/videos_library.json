      "sentences": [
        {
          "id": "S0001",
          "start": 0.0,
          "end": 28.5,
          "text": "Xin chào các bạn, hôm nay chúng ta sẽ cùng nhau tìm hiểu về bài số 8: Ép kiểu dữ liệu trong Python."
        },
        {
          "id": "S0002",
          "start": 28.5,
          "end": 52.0,
          "text": "Đầu tiên là khái niệm ép kiểu dữ liệu và tại sao chúng ta cần phải thực hiện ép kiểu trong các phép toán."
        },
        {
          "id": "S0003",
          "start": 52.0,
          "end": 75.0,
          "text": "Python hỗ trợ hai hình thức chuyển đổi kiểu dữ liệu chính: ép kiểu ngầm định và ép kiểu tường minh."
        },
        {
          "id": "S0004",
          "start": 75.0,
          "end": 130.0,
          "text": "Các hàm ép kiểu rõ ràng thông dụng nhất bao gồm int(), float(), str() và bool()."
        },
        {
          "id": "S0005",
          "start": 130.0,
          "end": 190.0,
          "text": "Nếu chúng ta thực hiện phép cộng giữa hai chuỗi, chương trình sẽ nối chuỗi thay vì cộng số học."
        },
        {
          "id": "S0006",
          "start": 190.0,
          "end": 242.0,
          "text": "Do đó ta phải thực hiện ép kiểu rõ ràng sang kiểu số nguyên int() hoặc số thực float()."
        },
        {
          "id": "S0007",
          "start": 242.0,
          "end": 285.0,
          "text": "Khi mà chúng ta gặp biến: Khai báo biến với nhiều định dạng dữ liệu khác nhau trong bộ nhớ."
        },
        {
          "id": "S0008",
          "start": 285.0,
          "end": 332.0,
          "text": "Cách kiểm tra kiểu dữ liệu của biến bằng hàm type() để tránh các xung đột ngầm."
        },
        {
          "id": "S0009",
          "start": 332.0,
          "end": 375.0,
          "text": "Gặp lỗi: Lỗi thường gặp nhất là ValueError khi ép chuỗi ký tự chữ cái sang số nguyên."
        },
        {
          "id": "S0010",
          "start": 375.0,
          "end": 421.0,
          "text": "Cách kiểm soát lỗi và kiểm tra dữ liệu trước khi thực hiện chuyển đổi kiểu."
        },
        {
          "id": "S0011",
          "start": 421.0,
          "end": 475.0,
          "text": "Bây giờ mình không ép kiểu thì chương trình sẽ chạy ra kết quả sai lệch như thế nào."
        },
        {
          "id": "S0012",
          "start": 475.0,
          "end": 535.0,
          "text": "Tổng kết toàn bộ bài học và bài tập thực hành ép kiểu dữ liệu trong Python."
        }
      ]
    }
